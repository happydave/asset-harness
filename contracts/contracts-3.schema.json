    "avatarPresets": {
      "description": "VRM preset expressions as compositions of authored shapes. The five visemes (aa ee ih oh ou) are entries of `composed`; `empty_by_design` names presets deliberately left unbound (bone-driven gaze); `overrides` are the VRM 1.0 override modes set on a preset.",
      "type": "object",
      "required": [
        "composed",
        "empty_by_design"
      ],
      "properties": {
        "composed": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/avatarPresetBind"
            }
          }
        },
        "empty_by_design": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "pattern": "^override_[a-z_]+$"
            },
            "additionalProperties": {
              "enum": [
                "none",
                "block",
                "blend"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
