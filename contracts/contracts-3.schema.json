    "avatarExpressions": {
      "description": "The declared clip vocabulary and the authored-vs-stub split: a declared name is either authored or listed under a stub reason, never both (rule R2 in contracts_rules).",
      "type": "object",
      "required": [
        "vocabulary",
        "declared",
        "authored",
        "stubs"
      ],
      "properties": {
        "vocabulary": {
          "enum": [
