# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Model weights / checkpoints (never commit these)
*.safetensors
*.ckpt
*.pt
*.pth
*.gguf
*.onnx

# Bulk generated output — commit representative samples explicitly with `git add -f`
**/output/
**/outputs/
**/_gen/

# Large media (allow small samples via `git add -f`)
*.mp4
*.mov
*.zip

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# mechanical-kit AI material sets — regenerable (gen_part_materials.py) + embedded in parts/*.glb
mechanical-kit/prototypes/materials/

# rigged-avatars: preview contact-sheets + separate-file debug exports are regenerable bulk.
# The deliverable glbs + manifests + the head bake-off montage are committed as representative samples.
rigged-avatars/prototypes/out/*_walk_*.png
rigged-avatars/prototypes/out/pop_*.png
rigged-avatars/prototypes/out/debug/
